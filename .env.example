# Local single-user application: keep API and Vite on loopback. See SECURITY.md.
MODEL_API_KEY=
MOCK_MODELS=0
DEMO_MODE=1
DATABASE_URL=sqlite:///./data/tapegrade.db
MAX_CANDIDATES=1
MAX_CLIPS_PER_CANDIDATE=2
MAX_SAM_RETRIES=0
MAX_LIVE_MODEL_CALLS_PER_SCAN=6
MAX_CLIP_SECONDS=5
MAX_UPLOAD_MB=100
META_BASE_URL=https://api.meta.ai
SPARK_MODEL=muse-spark-1.3
SPARK_MAX_COMPLETION_TOKENS=2048
SPARK_REASONING_EFFORT=low
SAM_MODEL=sam-3.1
IMAGE_MODEL=muse-image-1.0
MODEL_TIMEOUT_SECONDS=120
PERCEPTION_QUALITY_THRESHOLD=0.75
SCHEDULER_ENABLED=0
WORKER_POLL_SECONDS=1

# Recent NBA game logs. Leave unconfigured until source access is available.
NBA_STATS_PROVIDER=none
BALLDONTLIE_API_KEY=
STATS_WINDOW_DAYS=30
STATS_MAX_PAGES=60
STATS_TIMEOUT_SECONDS=90
STATS_FRESH_HOURS=24
# Sportradar NBA v8 alternative; header authentication, never exposed to React.
SPORTRADAR_API_KEY=
SPORTRADAR_ACCESS_LEVEL=trial
# For a bounded Sportradar trial refresh, choose NBA_STATS_PROVIDER=sportradar
# and STATS_WINDOW_DAYS=7 (all closed games; default cap 60 network requests).
# Use STATS_TIMEOUT_SECONDS=180 for a 7-day Sportradar trial refresh.
SPORTRADAR_MIN_INTERVAL_SECONDS=4

# Each live scan refreshes Sleeper and updates game logs older than this.
STATS_AUTO_REFRESH_MINUTES=60
# Optional authorized footage catalog. Leave blank if no licensed library is connected.
FOOTAGE_CATALOG_PATH=
FOOTAGE_MEDIA_ROOT=
FOOTAGE_ALLOWED_HOSTS=[]
FOOTAGE_MAX_AGE_DAYS=7
# Public viewing-link discovery never downloads or analyzes publisher video.
FOOTAGE_DISCOVERY_ENABLED=1
# Enable only after the user chooses public-source private analysis.
# Direct public ESPN MP4 clips are supported; authentication/DRM restrictions are never bypassed.
PUBLIC_FOOTAGE_ANALYSIS_ENABLED=0
